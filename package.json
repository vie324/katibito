{
  "name": "kikai-signal-demo",
  "private": true,
  "version": "0.1.0",
  "description": "面接の受け答えから行動シグナル(主張性・感情表出性)をリアルタイム可視化するデモ。ブラウザ完結・バックエンドなし。",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "predev": "npm run vendor",
    "dev": "vite",
    "prebuild": "npm run vendor",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "generate:sample": "vite-node scripts/generate-sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource/biz-udpgothic": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}

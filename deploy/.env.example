# このサーバーのドメイン(DNS の A レコードをこのサーバーの IP に向けておく)
DOMAIN=interview.example.jp

# 初期設定コードを固定したい場合だけ設定(空欄なら起動時に自動生成してログに出す)
INITIAL_SETUP_CODE=

# メールのお知らせ(使う場合だけ。SMTP_HOST と MAIL_FROM を設定するとメールを送る)
# 例: Google Workspace なら SMTP_HOST=smtp.gmail.com SMTP_PORT=587、ユーザーとアプリ パスワード
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 文字起こしのモデル(既定 small-q5_1。CPU が少ないサーバーでは base-q5_1 にすると速い)
WHISPER_MODEL=
